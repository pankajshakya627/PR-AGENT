# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Choose your LLM provider: openai, anthropic, or local
# Uncomment the one you want to use:

# Option 1: OpenAI (Recommended for best results)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 3: Local LLM via llama.cpp
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:12434/engines/llama.cpp/v1
# LOCAL_LLM_MODEL=ai/llama3.2:latest

# ============================================================================
# GitHub Configuration
# ============================================================================
# Optional: Only needed for private repositories
# GITHUB_TOKEN=your_github_personal_access_token

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================
# Uncomment to override defaults

# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4000
# AGENT_TIMEOUT=300
# AGENT_MAX_RETRIES=2
