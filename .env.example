# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Choose your LLM provider: openai, anthropic, openrouter, or local
# Uncomment the one you want to use:

# Option 1: OpenAI (Recommended for best results)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 3: OpenRouter (Access to Grok, Llama, and other models)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=x-ai/grok-beta
# # For free models with smaller context:
# # OPENROUTER_MODEL=x-ai/grok-4.1-fast:free
# # LLM_MAX_TOKENS=3000  # Reduce if hitting context limits

# Option 4: Local LLM via llama.cpp
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:12434/engines/llama.cpp/v1
# LOCAL_LLM_MODEL=ai/llama3.2:latest

# ============================================================================
# GitHub Configuration
# ============================================================================
# Optional: Only needed for private repositories
# GITHUB_TOKEN=your_github_personal_access_token

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================
# Uncomment to override defaults

# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4000
# AGENT_TIMEOUT=300
# AGENT_MAX_RETRIES=2

# ============================================================================
# Email Configuration (for Password Reset)
# ============================================================================
# Required for the "Forgot Password" email verification feature
# For Gmail: Enable 2FA and create an App Password at:
# https://myaccount.google.com/apppasswords

# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
